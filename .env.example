# Writer (Grok). A reasoning model, so the Writer thinks through each
# character before drafting (#18); it was grok-4.20-0309-non-reasoning.
# grok-4.7 is the one xAI documents as returning a readable reasoning
# summary, which the harness pane shows under each Draft.
XAI_API_KEY=
WRITER_MODEL=grok-4.7

# Drafter (small OpenAI model)
OPENAI_API_KEY=
DRAFTER_MODEL=

# Judge (Jev, TypeSafe AI)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# SQLite
DB_URL=./data/sands.db
